rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'member';
      allow update: if admin() || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname','address','birthDate','birthday']));
      allow delete: if admin();
    }
    match /bills/{id} {
      allow read: if signedIn() && (admin() || resource.data.uid == request.auth.uid);
      allow create, update, delete: if admin();
    }
    match /requests/{id} {
      allow read: if signedIn() && (admin() || resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if admin() || resource.data.uid == request.auth.uid;
    }
    match /borrows/{id} {
      allow read: if signedIn() && (admin() || resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if admin();
    }
  }
}