rules_version = '2';

// All reads/writes go through Next.js API routes using the Admin SDK,
// which bypasses these rules entirely. Client-side Firestore access is
// intentionally blocked so browsers can never query sensitive collections
// (users, bills, repairs, borrows, eventLogs) directly — every access is
// gated by the session check in lib/auth.ts on the server.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
