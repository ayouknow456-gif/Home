# ===== Firebase (client) =====
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== Firebase Admin (server only, never expose) =====
# Paste the full service-account JSON as a single-line string
FIREBASE_ADMIN_SDK_JSON=

# ===== Field-level encryption (AES-256) for bank account numbers, if ever stored =====
# 32-byte (64 hex char) key. Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=

# ===== Google Sheets =====
GOOGLE_SHEETS_ID=
# Paste the full service-account JSON as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON=

# ===== LINE Messaging API =====
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_OA_URL=https://line.me/R/ti/p/@YOUR_OA_ID

# ===== Session =====
# Random string used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
